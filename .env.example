# Gemini Configuration
GEMINI_API_KEY=your_key_here
ENABLE_GEMINI=true
ENABLE_CHAT_TITLES=true
ENABLE_LIVE_PIPELINE=true
ENABLE_COLLEGE_ENRICH=false
ENABLE_CAREER_GUIDANCE=true
ENABLE_GROUNDING=true
ENABLE_OBSERVABILITY=true
FLASH_DAILY_LIMIT=50
PRO_DAILY_LIMIT=5
